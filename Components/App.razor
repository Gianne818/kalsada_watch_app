<!DOCTYPE html>
<html lang="en" class="h-full scroll-smooth">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    
    <!-- Tailwind CSS CDN & Civic Theme Palette -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: { sans: ['"Plus Jakarta Sans"', 'sans-serif'] },
            colors: {
              'civic-bg': '#F0F6FF',
              'civic-primary': '#2563EB',
              'civic-dark': '#1E40AF',
              'civic-navy': '#2246CC',
              'civic-light': '#DBEAFE',
              'civic-title': '#0F172A',
              'civic-body': '#1E293B',
              'civic-muted': '#64748B',
              'civic-border': '#E2EAF4',
            }
          }
        }
      }
    </script>

    <!-- Google Fonts & Material Symbols -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />

    <!-- Leaflet CSS & JS for Interactive Road Damage Map & Heatmap -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

    <style>
      html {
        scroll-behavior: smooth;
      }
      
      @@keyframes pageFadeIn {
        0% {
          opacity: 0;
          transform: translateY(6px);
        }
        100% {
          opacity: 1;
          transform: translateY(0);
        }
      }

      .page-transition {
        animation: pageFadeIn 0.28s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      }
    </style>

    <HeadOutlet />
</head>

<body class="min-h-full font-sans bg-civic-bg text-civic-body antialiased">
    <Routes />
    <script src="_framework/blazor.web.js"></script>
    
    <script>
      function scrollToTargetSection(targetId) {
        if (!targetId) return;
        const el = document.getElementById(targetId);
        if (el) {
          el.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }

      function initScrollSpy() {
        const hash = window.location.hash ? window.location.hash.replace('#', '') : '';
        const params = new URLSearchParams(window.location.search);
        const tab = params.get('tab');
        const target = hash || (tab === 'workflow' ? 'workflow' : tab === 'map' ? 'map' : tab === 'stats' ? 'stats' : tab === 'emergency' ? 'emergency' : '');

        if (target) {
          setTimeout(() => scrollToTargetSection(target), 100);
        }
      }

      window.addEventListener('DOMContentLoaded', initScrollSpy);
      window.addEventListener('load', initScrollSpy);
      window.addEventListener('popstate', initScrollSpy);
    </script>
</body>

</html>