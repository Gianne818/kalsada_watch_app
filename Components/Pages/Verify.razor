    private int underConstructionCount => allReports.Count(r => r.Status == "Under Construction");
    private int finishedCount => allReports.Count(r => r.Status == "Finished");
    private int underInspectionCount => allReports.Count(r => r.Status == "Under Inspection");

    private List<RoadReport> FilteredReports
    {
        get
        {
            var query = allReports.AsEnumerable();

            if (selectedStatus != "All")
            {
                query = query.Where(r => r.Status == selectedStatus);
            }

            if (selectedDistrict != "All")
            {
                query = query.Where(r => r.District == selectedDistrict);
            }

            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                var q = searchQuery.Trim().ToLowerInvariant();
                query = query.Where(r => r.Title.ToLowerInvariant().Contains(q) ||
                                         r.Location.ToLowerInvariant().Contains(q) ||
                                         r.Id.ToLowerInvariant().Contains(q) ||
                                         r.HazardType.ToLowerInvariant().Contains(q));
            }

            query = selectedSort switch
            {
                "near" => query.OrderBy(r => r.DistanceFromCenterKm),
                "priority" => query.OrderByDescending(r => r.Severity == "High").ThenByDescending(r => r.Severity == "Medium"),
                _ => query.OrderBy(r => r.Status == "Under Construction" ? 0 : r.Status == "Under Inspection" ? 1 : 2)
            };

            return query.ToList();
        }
    }

    private void SetStatusFilter(string status)
    {
        selectedStatus = status;
        UpdateMapLayers();
    }

    private void ToggleHeatmap()
    {
        isHeatmapActive = !isHeatmapActive;
        UpdateMapLayers();
    }

    private void ResetAllFilters()
    {
        selectedStatus = "All";
        selectedDistrict = "All";
        selectedSort = "recent";
        searchQuery = "";
        UpdateMapLayers();
    }

    private void OpenAuditModal(RoadReport report)
    {
        selectedReport = report;
        isModalOpen = true;
    }

    private void CloseAuditModal()
    {
        isModalOpen = false;
    }

    private async Task FocusMapFromModal(RoadReport report)
    {
        CloseAuditModal();
        await FocusMapOnReport(report);
    }

    private async Task FocusMapOnReport(RoadReport report)
    {
        selectedReport = report;
        await JSRuntime.InvokeVoidAsync("kalsadaMap.panToLocation", report.Lat, report.Lng, report.Title, report.Status, report.Id);
    }

    private async Task ResetMapView()
    {
        await JSRuntime.InvokeVoidAsync("kalsadaMap.resetView");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await InitializeMap();
        }
    }

    private async Task InitializeMap()
    {
        var reportsJson = System.Text.Json.JsonSerializer.Serialize(allReports);
        await JSRuntime.InvokeVoidAsync("kalsadaMap.init", "verificationMap", reportsJson);
    }

    private async void UpdateMapLayers()
    {
        var filteredJson = System.Text.Json.JsonSerializer.Serialize(FilteredReports);
        await JSRuntime.InvokeVoidAsync("kalsadaMap.updateData", filteredJson, isHeatmapActive);
        StateHasChanged();
    }
}

<script>
  window.kalsadaMap = {
    mapInstance: null,
    markersGroup: null,
    heatmapGroup: null,

    init: function (elementId, reportsJson) {
      if (typeof L === 'undefined') {
        setTimeout(() => window.kalsadaMap.init(elementId, reportsJson), 200);
        return;
      }

      const container = document.getElementById(elementId);
      if (!container) return;

      if (window.kalsadaMap.mapInstance) {
        window.kalsadaMap.mapInstance.remove();
      }

      // Initialize map centered on City Center (Manila coordinates)
      const map = L.map(elementId, {
        scrollWheelZoom: true,
        zoomControl: true
      }).setView([14.5995, 120.9842], 13);

      window.kalsadaMap.mapInstance = map;

      // Add modern clean CartoDB / OpenStreetMap tile layer
      L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
        attribution: '&copy; <a href="https://carto.com/">CARTO</a>, OpenStreetMap',
        maxZoom: 19
      }).addTo(map);

      window.kalsadaMap.markersGroup = L.layerGroup().addTo(map);
      window.kalsadaMap.heatmapGroup = L.layerGroup().addTo(map);

      const reports = JSON.parse(reportsJson);
      window.kalsadaMap.renderMarkers(reports, false);
    },

    renderMarkers: function (reports, showHeatmap) {
      if (!window.kalsadaMap.mapInstance) return;

      window.kalsadaMap.markersGroup.clearLayers();
      window.kalsadaMap.heatmapGroup.clearLayers();

      reports.forEach(r => {
        // Status color mapping
        let color = '#2563EB'; // Blue (Inspection)
        let label = 'Under Inspection';
        if (r.Status === 'Under Construction') {
          color = '#F59E0B'; // Amber
          label = 'Under Construction';
        } else if (r.Status === 'Finished') {
          color = '#10B981'; // Emerald
          label = 'Finished & Repaired';
        }

        // Custom SVG Pin Marker
        const svgIcon = L.divIcon({
          className: 'custom-map-pin',
          html: `
            <div style="
              width: 32px;
              height: 32px;
              border-radius: 50% 50% 50% 0;
              background: ${color};
              transform: rotate(-45deg);
              display: flex;
              align-items: center;
              justify-content: center;
              border: 2.5px solid #FFFFFF;
              box-shadow: 0 4px 10px rgba(0,0,0,0.25);
              cursor: pointer;
              transition: transform 0.2s ease;
            ">
              <div style="
                width: 10px;
                height: 10px;
                border-radius: 50%;
                background: #FFFFFF;
              "></div>
            </div>
          `,
          iconSize: [32, 32],
          iconAnchor: [16, 32],
          popupAnchor: [0, -32]
        });

        const marker = L.marker([r.Lat, r.Lng], { icon: svgIcon });
        
        // Rich Popup Window
        const popupContent = `
          <div style="font-family: 'Plus Jakarta Sans', sans-serif; padding: 4px; min-width: 200px;">
            <div style="font-size: 10px; font-weight: 700; text-transform: uppercase; color: ${color}; margin-bottom: 2px;">
              ● ${label} (${r.ProgressPercent}%)
            </div>
            <div style="font-size: 13px; font-weight: 700; color: #0F172A; margin-bottom: 4px;">
              ${r.Title}
            </div>
            <div style="font-size: 11px; color: #64748B; margin-bottom: 6px;">
              📍 ${r.Location}
            </div>
            <div style="font-size: 11px; background: #F1F5F9; padding: 4px 8px; border-radius: 6px; color: #334155;">
              Crew: <strong>${r.AssignedCrew}</strong>
            </div>
          </div>
        `;

        marker.bindPopup(popupContent);
        window.kalsadaMap.markersGroup.addLayer(marker);

        // Heatmap density visualization (radial pulsing gradient circles)
        if (showHeatmap) {
          const heatColor = (r.Status === 'Under Construction' || r.Severity === 'High') ? '#EF4444' : '#F59E0B';
          const radius = (r.Severity === 'High') ? 450 : 320;
          
          const heatCircle = L.circle([r.Lat, r.Lng], {
            radius: radius,
            color: heatColor,
            fillColor: heatColor,
            fillOpacity: 0.28,
            weight: 1.5,
            dashArray: '4, 4'
          });

          window.kalsadaMap.heatmapGroup.addLayer(heatCircle);
        }
      });
    },

    updateData: function (filteredReportsJson, showHeatmap) {
      if (!window.kalsadaMap.mapInstance) return;
      const reports = JSON.parse(filteredReportsJson);
      window.kalsadaMap.renderMarkers(reports, showHeatmap);
    },

    panToLocation: function (lat, lng, title, status, id) {
      if (!window.kalsadaMap.mapInstance) return;
      window.kalsadaMap.mapInstance.flyTo([lat, lng], 16, {
        duration: 1.2,
        easeLinearity: 0.25
      });
    },

    resetView: function () {
      if (!window.kalsadaMap.mapInstance) return;
      window.kalsadaMap.mapInstance.flyTo([14.5995, 120.9842], 13, { duration: 1 });
    }
  };
</script>
