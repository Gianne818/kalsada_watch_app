@page "/verify"
@page "/map"
@rendermode InteractiveServer
@inject IJSRuntime JSRuntime

<PageTitle>KalsadaWatch - Road Status Verification & Damage Heat Map</PageTitle>

<div class="min-h-screen font-sans bg-civic-bg text-civic-body antialiased flex flex-col scroll-smooth page-transition">
  <!-- Navigation Bar with Animated Indicator -->
  <header class="w-full sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-civic-border transition-all duration-300">
    <div class="max-w-7xl mx-auto px-6 lg:px-10 h-20 flex items-center justify-between">
      <a href="/?tab=home#top" class="flex items-center gap-3 group active:scale-95 transition-transform duration-200 cursor-pointer">
        <div class="w-10 h-10 rounded-xl bg-civic-light text-civic-primary flex items-center justify-center group-hover:bg-civic-primary group-hover:text-white transition-all duration-300 shadow-sm">
          <span class="material-symbols-outlined text-2xl">account_balance</span>
        </div>
        <div>
          <span class="text-xl font-bold tracking-tight text-civic-primary group-hover:text-civic-dark transition-colors">KalsadaWatch</span>
          <span class="block text-xs text-civic-muted -mt-0.5">Public Infrastructure Monitoring</span>
        </div>
      </a>

      <!-- Functional In-Page Nav Links with Animated Active Indicator -->
      <nav class="hidden md:flex items-center gap-8 text-sm font-medium">
        
        <!-- Home Tab -->
        <a href="/?tab=home#top" 
           class="group relative pb-2 transition-all duration-200 cursor-pointer active:scale-95 text-civic-muted hover:text-civic-primary">
          Home
          <span class="absolute bottom-0 left-0 h-[2.5px] rounded-full bg-civic-primary transition-all duration-300 ease-out w-0 opacity-0 group-hover:w-full group-hover:opacity-40"></span>
        </a>

        <!-- Report Road Tab -->
        <a href="report" 
           class="group relative pb-2 transition-all duration-200 cursor-pointer active:scale-95 text-civic-muted hover:text-civic-primary">
          Report Road
          <span class="absolute bottom-0 left-0 h-[2.5px] rounded-full bg-civic-primary transition-all duration-300 ease-out w-0 opacity-0 group-hover:w-full group-hover:opacity-40"></span>
        </a>

        <!-- How It Works Tab -->
        <a href="/?tab=workflow#workflow" 
           class="group relative pb-2 transition-all duration-200 cursor-pointer active:scale-95 text-civic-muted hover:text-civic-primary">
          How It Works
          <span class="absolute bottom-0 left-0 h-[2.5px] rounded-full bg-civic-primary transition-all duration-300 ease-out w-0 opacity-0 group-hover:w-full group-hover:opacity-40"></span>
        </a>

        <!-- Road Damage Map Tab (ACTIVE) -->
        <a href="verify" 
           class="group relative pb-2 transition-all duration-200 cursor-pointer active:scale-95 text-civic-primary font-semibold">
          Road Damage Map
          <span class="absolute bottom-0 left-0 h-[2.5px] rounded-full bg-civic-primary transition-all duration-300 ease-out w-full opacity-100 shadow-[0_1px_6px_rgba(37,99,235,0.4)]"></span>
        </a>

        <!-- Statistics Tab -->
        <a href="/?tab=stats#stats" 
           class="group relative pb-2 transition-all duration-200 cursor-pointer active:scale-95 text-civic-muted hover:text-civic-primary">
          Statistics
          <span class="absolute bottom-0 left-0 h-[2.5px] rounded-full bg-civic-primary transition-all duration-300 ease-out w-0 opacity-0 group-hover:w-full group-hover:opacity-40"></span>
        </a>

        <!-- Help / Support Tab -->
        <a href="/?tab=emergency#emergency" 
           class="group relative pb-2 transition-all duration-200 cursor-pointer active:scale-95 text-civic-muted hover:text-civic-primary">
          Help / Support
          <span class="absolute bottom-0 left-0 h-[2.5px] rounded-full bg-civic-primary transition-all duration-300 ease-out w-0 opacity-0 group-hover:w-full group-hover:opacity-40"></span>
        </a>

      </nav>

      <!-- Routing Buttons -->
      <div class="flex items-center gap-3">
        <a href="signin" class="text-sm font-semibold text-civic-primary px-4 py-2 hover:bg-civic-light/60 active:scale-95 rounded-full transition-all duration-200 cursor-pointer">Sign In</a>
        <a href="register" class="text-sm font-semibold text-white bg-civic-primary hover:bg-civic-dark active:scale-95 hover:shadow-md hover:-translate-y-0.5 px-5 py-2.5 rounded-full shadow-sm transition-all duration-200 cursor-pointer inline-flex items-center gap-1">Register</a>
      </div>
    </div>
  </header>

  <!-- Main Content Body -->
  <main class="flex-1 max-w-7xl mx-auto w-full px-6 lg:px-10 py-8">
    
    <!-- Top Hero Header & Public Works Counters -->
    <div class="mb-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-6 border-b border-civic-border">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-civic-light text-civic-primary text-xs font-semibold mb-3">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> Live Public Works Transparency Hub
          </div>
          <h1 class="text-3xl sm:text-4xl font-bold text-civic-title tracking-tight">
            Road Status Verification & Hazard Heat Map
          </h1>
          <p class="text-sm sm:text-base text-civic-muted mt-2 max-w-2xl leading-relaxed">
            Verify whether reported municipal roadway hazards are currently under construction, completed by asphalt crews, or queued for engineering inspection.
          </p>
        </div>

        <!-- Live Status Metrics Badges -->
        <div class="flex flex-wrap items-center gap-3">
          <div class="flex items-center gap-2.5 px-4 py-2.5 rounded-2xl bg-amber-50 border border-amber-200 shadow-sm">
            <span class="w-2.5 h-2.5 rounded-full bg-amber-500 animate-pulse"></span>
            <div>
              <div class="text-xs text-amber-700 font-medium">Under Construction</div>
              <div class="text-lg font-bold text-amber-900 leading-tight">@underConstructionCount Zones</div>
            </div>
          </div>

          <div class="flex items-center gap-2.5 px-4 py-2.5 rounded-2xl bg-emerald-50 border border-emerald-200 shadow-sm">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
            <div>
              <div class="text-xs text-emerald-700 font-medium">Finished & Repaired</div>
              <div class="text-lg font-bold text-emerald-900 leading-tight">@finishedCount Roads</div>
            </div>
          </div>

          <div class="flex items-center gap-2.5 px-4 py-2.5 rounded-2xl bg-blue-50 border border-blue-200 shadow-sm">
            <span class="w-2.5 h-2.5 rounded-full bg-blue-500"></span>
            <div>
              <div class="text-xs text-blue-700 font-medium">Under Inspection</div>
              <div class="text-lg font-bold text-blue-900 leading-tight">@underInspectionCount Queued</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Interactive Filters & Map View Controls -->
      <div class="mt-6 flex flex-col lg:flex-row gap-4 justify-between items-stretch lg:items-center">
        
        <!-- Search Input -->
        <div class="relative flex-1 max-w-md">
          <span class="material-symbols-outlined absolute left-3.5 top-3 text-slate-400 text-lg">search</span>
          <input type="text" 
                 @bind="searchQuery" 
                 @bind:event="oninput" 
                 placeholder="Search by road name, landmark, or ID..." 
                 class="w-full pl-10 pr-10 py-2.5 rounded-xl border border-civic-border bg-white text-sm text-civic-title placeholder:text-slate-400 focus:outline-none focus:border-civic-primary focus:ring-2 focus:ring-civic-primary/15 transition-all shadow-sm" />
          @if (!string.IsNullOrEmpty(searchQuery))
          {
            <button @onclick='() => searchQuery = ""' class="material-symbols-outlined absolute right-3 top-2.5 text-slate-400 hover:text-slate-600 text-lg">
              close
            </button>
          }
        </div>

        <!-- Filter Pill Group: Status -->
        <div class="flex flex-wrap items-center gap-2">
          <button @onclick='() => SetStatusFilter("All")' 
                  class="px-4 py-2 rounded-xl text-xs font-semibold transition-all @(selectedStatus == "All" ? "bg-civic-primary text-white shadow-sm" : "bg-white border border-civic-border text-civic-muted hover:text-civic-title hover:border-civic-primary/40")">
            All Statuses (@allReports.Count)
          </button>
          <button @onclick='() => SetStatusFilter("Under Construction")' 
                  class="px-4 py-2 rounded-xl text-xs font-semibold transition-all @(selectedStatus == "Under Construction" ? "bg-amber-500 text-white shadow-sm" : "bg-white border border-civic-border text-amber-700 hover:bg-amber-50")">
            🟡 Under Construction (@underConstructionCount)
          </button>
          <button @onclick='() => SetStatusFilter("Finished")' 
                  class="px-4 py-2 rounded-xl text-xs font-semibold transition-all @(selectedStatus == "Finished" ? "bg-emerald-600 text-white shadow-sm" : "bg-white border border-civic-border text-emerald-700 hover:bg-emerald-50")">
            🟢 Finished (@finishedCount)
          </button>
          <button @onclick='() => SetStatusFilter("Under Inspection")' 
                  class="px-4 py-2 rounded-xl text-xs font-semibold transition-all @(selectedStatus == "Under Inspection" ? "bg-blue-600 text-white shadow-sm" : "bg-white border border-civic-border text-blue-700 hover:bg-blue-50")">
            🔵 Inspection (@underInspectionCount)
          </button>
        </div>

        <!-- Secondary Controls: District & Sort -->
        <div class="flex items-center gap-3">
          <!-- District Dropdown -->
          <div class="relative">
            <select @bind="selectedDistrict" class="px-3.5 pr-8 py-2 rounded-xl bg-white border border-civic-border text-xs font-semibold text-civic-title focus:outline-none focus:border-civic-primary focus:ring-2 focus:ring-civic-primary/15 appearance-none cursor-pointer shadow-sm">
              <option value="All">All Districts</option>
              <option value="Central District">Central District</option>
              <option value="North District">North District</option>
              <option value="South Urban Corridor">South Corridor</option>
              <option value="East Industrial Zone">East Industrial</option>
              <option value="West Municipal Area">West Municipal</option>
            </select>
            <span class="material-symbols-outlined absolute right-2.5 top-2 text-slate-400 text-base pointer-events-none">expand_more</span>
          </div>

          <!-- Sort Dropdown (Near area / Recently added) -->
          <div class="relative">
            <select @bind="selectedSort" class="px-3.5 pr-8 py-2 rounded-xl bg-white border border-civic-border text-xs font-semibold text-civic-title focus:outline-none focus:border-civic-primary focus:ring-2 focus:ring-civic-primary/15 appearance-none cursor-pointer shadow-sm">
              <option value="recent">⚡ Recently Added</option>
              <option value="near">📍 Near City Center</option>
              <option value="priority">🚨 Highest Priority</option>
            </select>
            <span class="material-symbols-outlined absolute right-2.5 top-2 text-slate-400 text-base pointer-events-none">expand_more</span>
          </div>

          <!-- Heatmap Layer Toggle -->
          <button @onclick="ToggleHeatmap" 
                  class="px-3.5 py-2 rounded-xl text-xs font-semibold flex items-center gap-1.5 transition-all @(isHeatmapActive ? "bg-rose-500 text-white shadow-sm" : "bg-white border border-civic-border text-civic-title hover:bg-slate-50")"
                  title="Toggle Heat Map visualization showing high concentration of road damage">
            <span class="material-symbols-outlined text-sm">local_fire_department</span>
            <span>@(isHeatmapActive ? "Heat Map Active" : "Heat Map")</span>
          </button>
        </div>

      </div>
    </div>

    <!-- Main Grid: Interactive Map (Left/Top) & Filtered Report Cards (Right/Bottom) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Interactive Map Column (7 cols) -->
      <div class="lg:col-span-7 space-y-4">
        <div class="bg-white p-4 rounded-3xl border border-civic-border shadow-[0_8px_30px_rgb(0,0,0,0.04)] relative">
          
          <!-- Map Top Floating Status Strip -->
          <div class="flex items-center justify-between mb-3 px-1">
            <div class="flex items-center gap-2 text-xs font-bold text-civic-title">
              <span class="material-symbols-outlined text-civic-primary text-base">map</span>
              <span>Civic Infrastructure GIS Map</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-[11px] text-civic-muted bg-slate-100 px-2.5 py-1 rounded-full">
                Interactive Pan & Zoom Enabled
              </span>
              <button @onclick="ResetMapView" class="px-2.5 py-1 rounded-lg text-[11px] font-semibold bg-civic-light text-civic-primary hover:bg-blue-200 transition-colors">
                Center Map
              </button>
            </div>
          </div>

          <!-- Leaflet Map Container -->
          <div id="verificationMap" class="w-full h-[540px] rounded-2xl overflow-hidden border border-slate-200 z-10"></div>

          <!-- Map Legend Bar Below -->
          <div class="mt-3.5 pt-3 border-t border-slate-100 flex flex-wrap items-center justify-between gap-3 text-[11px] text-civic-muted px-1">
            <div class="flex items-center gap-4">
              <span class="inline-flex items-center gap-1.5 font-medium">
                <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span> Under Construction
              </span>
              <span class="inline-flex items-center gap-1.5 font-medium">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span> Finished & Paved
              </span>
              <span class="inline-flex items-center gap-1.5 font-medium">
                <span class="w-2.5 h-2.5 rounded-full bg-blue-500"></span> Under Inspection
              </span>
              @if (isHeatmapActive)
              {
                <span class="inline-flex items-center gap-1.5 font-medium text-rose-600 font-semibold">
                  <span class="w-2.5 h-2.5 rounded-full bg-rose-500 animate-ping"></span> Thermal Hazard Clusters
                </span>
              }
            </div>
            <span class="text-[11px] text-slate-400">Click any pin or card to inspect verification</span>
          </div>

        </div>
      </div>

      <!-- Reports List Column (5 cols) -->
      <div class="lg:col-span-5 space-y-4">
        
        <!-- List Header Bar -->
        <div class="flex items-center justify-between px-1">
          <h2 class="text-sm font-bold text-civic-title flex items-center gap-2">
            <span class="material-symbols-outlined text-base text-civic-primary">format_list_bulleted</span>
            <span>Reported Road Statuses</span>
            <span class="text-xs px-2 py-0.5 rounded-full bg-civic-light text-civic-primary font-bold">@FilteredReports.Count</span>
          </h2>
          <span class="text-xs text-civic-muted">Showing filtered public works dispatches</span>
        </div>

        <!-- Scrollable Report Cards List -->
        <div class="space-y-3.5 max-h-[600px] overflow-y-auto pr-1">
          @if (FilteredReports.Count == 0)
          {
            <div class="bg-white rounded-2xl border border-civic-border p-12 text-center">
              <div class="w-12 h-12 rounded-full bg-civic-light text-civic-primary flex items-center justify-center mx-auto mb-3">
                <span class="material-symbols-outlined text-2xl">search_off</span>
              </div>
              <h3 class="text-sm font-bold text-civic-title">No Road Hazard Reports Found</h3>
              <p class="text-xs text-civic-muted mt-1 max-w-xs mx-auto">
                No reports matched your current filter criteria. Try resetting the status or district filter.
              </p>
              <button @onclick="ResetAllFilters" class="mt-4 px-4 py-2 rounded-xl text-xs font-semibold bg-civic-primary text-white hover:bg-civic-dark transition-colors">
                Reset All Filters
              </button>
            </div>
          }
          else
          {
            @foreach (var report in FilteredReports)
            {
              <div class="p-5 bg-white rounded-2xl border transition-all duration-200 @(selectedReport?.Id == report.Id ? "border-civic-primary ring-2 ring-civic-primary/20 shadow-md" : "border-civic-border hover:border-civic-primary/40 shadow-sm")">
                
                <!-- Card Header: Status Badge & ID -->
                <div class="flex items-center justify-between mb-2.5">
                  @if (report.Status == "Under Construction")
                  {
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold bg-amber-50 text-amber-800 border border-amber-200">
                      <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span> Under Construction (@report.ProgressPercent%)
                    </span>
                  }
                  else if (report.Status == "Finished")
                  {
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-800 border border-emerald-200">
                      <span class="material-symbols-outlined text-xs">verified</span> Finished & Repaired (100%)
                    </span>
                  }
                  else
                  {
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold bg-blue-50 text-blue-800 border border-blue-200">
                      <span class="w-2 h-2 rounded-full bg-blue-500"></span> Under Engineering Review
                    </span>
                  }

                  <span class="text-xs font-mono font-bold text-civic-muted bg-slate-100 px-2 py-0.5 rounded">
                    #@report.Id
                  </span>
                </div>

                <!-- Title & Location -->
                <h3 class="text-sm font-bold text-civic-title leading-snug">@report.Title</h3>
                <div class="flex items-center gap-1 text-xs text-civic-muted mt-1">
                  <span class="material-symbols-outlined text-sm text-slate-400">location_on</span>
                  <span>@report.Location</span>
                </div>

                <!-- Progress Bar -->
                <div class="mt-3.5 space-y-1">
                  <div class="flex items-center justify-between text-[11px]">
                    <span class="text-civic-muted font-medium">Asphalt Repair Progress</span>
                    <span class="font-bold @(report.Status == "Finished" ? "text-emerald-600" : report.Status == "Under Construction" ? "text-amber-600" : "text-blue-600")">
                      @report.ProgressPercent%
                    </span>
                  </div>
                  <div class="w-full h-2 rounded-full bg-slate-100 overflow-hidden">
                    <div class="h-full rounded-full transition-all duration-500 @(report.Status == "Finished" ? "bg-emerald-500" : report.Status == "Under Construction" ? "bg-amber-500" : "bg-blue-500")"
                         style="width: @(report.ProgressPercent)%"></div>
                  </div>
                </div>

                <!-- Meta Footer: Crew & Actions -->
                <div class="flex items-center justify-between pt-3 mt-3 border-t border-slate-100 text-xs">
                  <div class="text-[11px] text-civic-muted">
                    <span class="block font-medium text-slate-700">@report.AssignedCrew</span>
                    <span>@report.District &bull; @report.DateReported</span>
                  </div>

                  <div class="flex items-center gap-2">
                    <button @onclick="() => FocusMapOnReport(report)" 
                            class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-civic-light text-civic-primary hover:bg-blue-200 transition-colors flex items-center gap-1">
                      <span class="material-symbols-outlined text-xs">my_location</span>
                      <span>Map</span>
                    </button>
                    <button @onclick="() => OpenAuditModal(report)" 
                            class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-100 text-civic-title hover:bg-slate-200 transition-colors flex items-center gap-1">
                      <span class="material-symbols-outlined text-xs">verified_user</span>
                      <span>Verify</span>
                    </button>
                  </div>
                </div>

              </div>
            }
          }
        </div>

      </div>

    </div>

  </main>

  <!-- Interactive Public Works Verification Audit Modal -->
  @if (isModalOpen && selectedReport != null)
  {
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm animate-fade-in" @onclick="CloseAuditModal">
      <div class="bg-white rounded-3xl border border-civic-border max-w-lg w-full p-6 sm:p-8 shadow-2xl space-y-6 relative" @onclick:stopPropagation>
        
        <!-- Modal Close Button -->
        <button @onclick="CloseAuditModal" class="absolute top-5 right-5 w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-600 flex items-center justify-center transition-colors">
          <span class="material-symbols-outlined text-lg">close</span>
        </button>

        <!-- Top Certificate Badge -->
        <div>
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-100 text-emerald-800 text-xs font-semibold mb-2">
            <span class="material-symbols-outlined text-sm">verified</span> Official Municipal Public Works Audit
          </div>
          <h2 class="text-xl sm:text-2xl font-bold text-civic-title">@selectedReport.Title</h2>
          <p class="text-xs text-civic-muted mt-1 flex items-center gap-1">
            <span class="material-symbols-outlined text-sm">pin_drop</span> @selectedReport.Location &bull; @selectedReport.District
          </p>
        </div>

        <!-- Status & Timeline Box -->
        <div class="p-4 rounded-2xl bg-civic-bg border border-civic-border space-y-3">
          <div class="flex items-center justify-between text-xs">
            <span class="text-civic-muted">Current Civic Status</span>
            <span class="font-bold @(selectedReport.Status == "Finished" ? "text-emerald-700" : selectedReport.Status == "Under Construction" ? "text-amber-700" : "text-blue-700")">
              @selectedReport.Status (@selectedReport.ProgressPercent%)
            </span>
          </div>
          <div class="w-full h-2.5 rounded-full bg-slate-200 overflow-hidden">
            <div class="h-full rounded-full @(selectedReport.Status == "Finished" ? "bg-emerald-500" : selectedReport.Status == "Under Construction" ? "bg-amber-500" : "bg-blue-500")"
                 style="width: @(selectedReport.ProgressPercent)%"></div>
          </div>
          <div class="flex items-center justify-between text-[11px] text-civic-muted pt-1">
            <span>Reported: @selectedReport.DateReported</span>
            <span>@(selectedReport.Status == "Finished" ? $"Completed: {selectedReport.CompletionDate}" : $"Target: {selectedReport.CompletionDate}")</span>
          </div>
        </div>

        <!-- Technical Field Inspection Specifications -->
        <div class="grid grid-cols-2 gap-3 text-xs">
          <div class="p-3 rounded-xl bg-slate-50 border border-slate-200">
            <span class="block text-[11px] text-civic-muted mb-0.5">Assigned Engineering Crew</span>
            <strong class="text-civic-title font-semibold">@selectedReport.AssignedCrew</strong>
          </div>
          <div class="p-3 rounded-xl bg-slate-50 border border-slate-200">
            <span class="block text-[11px] text-civic-muted mb-0.5">Hazard Severity Rating</span>
            <strong class="text-civic-title font-semibold">@selectedReport.Severity Priority</strong>
          </div>
          <div class="p-3 rounded-xl bg-slate-50 border border-slate-200">
            <span class="block text-[11px] text-civic-muted mb-0.5">Citizen Confirmations</span>
            <strong class="text-emerald-700 font-semibold">@selectedReport.CitizenVerifications Citizens Verified</strong>
          </div>
          <div class="p-3 rounded-xl bg-slate-50 border border-slate-200">
            <span class="block text-[11px] text-civic-muted mb-0.5">Ticket Reference ID</span>
            <strong class="font-mono text-civic-primary font-bold">#@selectedReport.Id</strong>
          </div>
        </div>

        <!-- Field Engineer Notes -->
        <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 text-xs">
          <span class="block font-bold text-civic-title mb-1">Public Works Inspection Notes:</span>
          <p class="text-civic-muted leading-relaxed">
            @selectedReport.Notes
          </p>
        </div>

        <!-- Modal Actions -->
        <div class="flex items-center gap-3 pt-2">
          <button @onclick="() => FocusMapFromModal(selectedReport)" class="flex-1 h-11 rounded-full bg-civic-primary hover:bg-civic-dark text-white font-semibold text-xs flex items-center justify-center gap-1.5 transition-colors shadow-sm">
            <span class="material-symbols-outlined text-sm">my_location</span> Center on Interactive Map
          </button>
          <button @onclick="CloseAuditModal" class="px-5 h-11 rounded-full border border-slate-200 text-civic-muted hover:text-civic-title font-semibold text-xs transition-colors">
            Close
          </button>
        </div>

      </div>
    </div>
  }

</div>

