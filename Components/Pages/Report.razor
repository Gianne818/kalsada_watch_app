@page "/report"
@rendermode InteractiveServer

<PageTitle>KalsadaWatch - Report Road Hazard</PageTitle>

<div class="min-h-screen font-sans bg-civic-bg text-civic-body antialiased flex flex-col justify-between scroll-smooth page-transition">
  <!-- Navigation Bar with Animated Indicator -->
  <header class="w-full sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-civic-border transition-all duration-300">
    <div class="max-w-7xl mx-auto px-6 lg:px-10 h-20 flex items-center justify-between">
      <!-- Left Logo -->
      <a href="/?tab=home#top" class="flex items-center gap-3 group active:scale-95 transition-transform duration-200 cursor-pointer">
        <div class="w-10 h-10 rounded-xl bg-civic-light text-civic-primary flex items-center justify-center group-hover:bg-civic-primary group-hover:text-white transition-all duration-300 shadow-sm">
          <span class="material-symbols-outlined text-2xl">account_balance</span>
        </div>
        <div>
          <span class="text-xl font-bold tracking-tight text-civic-primary group-hover:text-civic-dark transition-colors">KalsadaWatch</span>
          <span class="block text-xs text-civic-muted -mt-0.5">Public Infrastructure Monitoring</span>
        </div>
      </a>

      <!-- Functional In-Page Nav Links with Animated Active Indicator -->
      <nav class="hidden md:flex items-center gap-8 text-sm font-medium">
        
        <!-- Home Tab -->
        <a href="/?tab=home#top" 
           class="group relative pb-2 transition-all duration-200 cursor-pointer active:scale-95 text-civic-muted hover:text-civic-primary">
          Home
          <span class="absolute bottom-0 left-0 h-[2.5px] rounded-full bg-civic-primary transition-all duration-300 ease-out w-0 opacity-0 group-hover:w-full group-hover:opacity-40"></span>
        </a>

        <!-- Report Road Tab (ACTIVE) -->
        <a href="report" 
           class="group relative pb-2 transition-all duration-200 cursor-pointer active:scale-95 text-civic-primary font-semibold">
          Report Road
          <span class="absolute bottom-0 left-0 h-[2.5px] rounded-full bg-civic-primary transition-all duration-300 ease-out w-full opacity-100 shadow-[0_1px_6px_rgba(37,99,235,0.4)]"></span>
        </a>

        <!-- How It Works Tab -->
        <a href="/?tab=workflow#workflow" 
           class="group relative pb-2 transition-all duration-200 cursor-pointer active:scale-95 text-civic-muted hover:text-civic-primary">
          How It Works
          <span class="absolute bottom-0 left-0 h-[2.5px] rounded-full bg-civic-primary transition-all duration-300 ease-out w-0 opacity-0 group-hover:w-full group-hover:opacity-40"></span>
        </a>

        <!-- Road Damage Map Tab -->
        <a href="verify" 
           class="group relative pb-2 transition-all duration-200 cursor-pointer active:scale-95 text-civic-muted hover:text-civic-primary">
          Road Damage Map
          <span class="absolute bottom-0 left-0 h-[2.5px] rounded-full bg-civic-primary transition-all duration-300 ease-out w-0 opacity-0 group-hover:w-full group-hover:opacity-40"></span>
        </a>

        <!-- Feedback Tab -->
        <a href="/?tab=feedback#citizen-feedback" 
           class="group relative pb-2 transition-all duration-200 cursor-pointer active:scale-95 text-civic-muted hover:text-civic-primary">
          Feedback
          <span class="absolute bottom-0 left-0 h-[2.5px] rounded-full bg-civic-primary transition-all duration-300 ease-out w-0 opacity-0 group-hover:w-full group-hover:opacity-40"></span>
        </a>

      </nav>

      <!-- Routing Buttons -->
      <div class="flex items-center gap-3">
        <a href="signin" class="text-sm font-semibold text-civic-primary px-4 py-2 hover:bg-civic-light/60 active:scale-95 rounded-full transition-all duration-200 cursor-pointer">Sign In</a>
        <a href="register" class="text-sm font-semibold text-white bg-civic-primary hover:bg-civic-dark active:scale-95 hover:shadow-md hover:-translate-y-0.5 px-5 py-2.5 rounded-full shadow-sm transition-all duration-200 cursor-pointer inline-flex items-center gap-1">Register</a>
      </div>
    </div>
  </header>

  <!-- Report Form Container -->
  <main class="flex-1 max-w-2xl mx-auto w-full py-12 px-6">
    <div class="bg-white rounded-3xl border border-civic-border p-8 sm:p-10 shadow-[0_10px_30px_-10px_rgba(37,99,235,0.08)]">
      
      <!-- Top Pill & Title Header -->
      <div class="mb-8">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-civic-light text-civic-primary text-xs font-semibold mb-3">
          <span class="w-2 h-2 rounded-full bg-civic-primary animate-pulse"></span> Public Hazard Dispatch
        </div>
        <h1 class="text-2xl sm:text-[28px] font-bold text-civic-title tracking-tight">Report Road Hazard</h1>
        <p class="text-xs sm:text-sm text-civic-muted mt-2 leading-relaxed">
          Submit photo evidence and geotagged incident coordinates to dispatch rapid municipal asphalt repair teams.
        </p>
      </div>

      <form class="space-y-5" onsubmit="return false;">
        <!-- Location / Street -->
        <div>
          <label class="block text-xs font-semibold text-civic-title mb-1.5">Hazard Location or Nearest Landmark <span class="text-red-500">*</span></label>
          <div class="relative">
            <span class="material-symbols-outlined absolute left-3.5 top-3 text-slate-400 text-lg">location_on</span>
            <input type="text" placeholder="e.g. Corner Main Ave & 4th Street, in front of City Hall" class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-civic-border text-sm text-civic-title placeholder:text-slate-400 focus:outline-none focus:border-civic-primary focus:ring-2 focus:ring-civic-primary/15" required />
          </div>
        </div>

        <!-- Hazard Type & Severity (Clean with NO default pre-selected data) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-civic-title mb-1.5">Hazard Type <span class="text-red-500">*</span></label>
            <div class="relative">
              <select class="w-full px-4 py-2.5 rounded-xl border border-civic-border text-sm text-civic-title focus:outline-none focus:border-civic-primary focus:ring-2 focus:ring-civic-primary/15 appearance-none bg-white cursor-pointer" required>
                <option value="" disabled selected>Select hazard type</option>
                <option>Deep Pothole</option>
                <option>Alligator / Surface Cracks</option>
                <option>Drain / Manhole Collapse</option>
                <option>Road Shoulder Cavity</option>
              </select>
              <span class="material-symbols-outlined absolute right-3 top-2.5 text-slate-400 text-lg pointer-events-none">expand_more</span>
            </div>
          </div>

          <div>
            <label class="block text-xs font-semibold text-civic-title mb-1.5">Severity Rating <span class="text-red-500">*</span></label>
            <div class="relative">
              <select class="w-full px-4 py-2.5 rounded-xl border border-civic-border text-sm text-civic-title focus:outline-none focus:border-civic-primary focus:ring-2 focus:ring-civic-primary/15 appearance-none bg-white cursor-pointer" required>
                <option value="" disabled selected>Select severity level</option>
                <option>High Priority (Deep cavity, vehicle risk)</option>
                <option>Medium Priority (Standard road erosion)</option>
                <option>Low Priority (Early surface degradation)</option>
              </select>
              <span class="material-symbols-outlined absolute right-3 top-2.5 text-slate-400 text-lg pointer-events-none">expand_more</span>
            </div>
          </div>
        </div>

        <!-- District Selection -->
        <div>
          <label class="block text-xs font-semibold text-civic-title mb-1.5">City District / Operational Area <span class="text-red-500">*</span></label>
          <div class="relative">
            <select class="w-full px-4 py-2.5 rounded-xl border border-civic-border text-sm text-civic-title focus:outline-none focus:border-civic-primary focus:ring-2 focus:ring-civic-primary/15 appearance-none bg-white cursor-pointer" required>
              <option value="" disabled selected>Select administrative district</option>
              <option>Central District</option>
              <option>North District</option>
              <option>South District</option>
              <option>East Industrial Zone</option>
              <option>West Municipal Area</option>
            </select>
            <span class="material-symbols-outlined absolute right-3 top-2.5 text-slate-400 text-lg pointer-events-none">expand_more</span>
          </div>
        </div>

        <!-- Photo Upload Box -->
        <div>
          <label class="block text-xs font-semibold text-civic-title mb-1.5">Upload On-Site Photo Proof</label>
          <div class="border-2 border-dashed border-civic-border hover:border-civic-primary/50 rounded-2xl p-6 text-center transition-colors cursor-pointer bg-slate-50/50">
            <div class="w-10 h-10 rounded-full bg-civic-light text-civic-primary flex items-center justify-center mx-auto mb-2">
              <span class="material-symbols-outlined text-xl">photo_camera</span>
            </div>
            <p class="text-xs font-semibold text-civic-title">Click to attach or drag roadway photo</p>
            <p class="text-[11px] text-slate-400 mt-1">JPEG, PNG files up to 10MB accepted</p>
          </div>
        </div>

        <!-- Notes / Textarea -->
        <div>
          <label class="block text-xs font-semibold text-civic-title mb-1.5">Hazard Observation Details</label>
          <textarea rows="3" placeholder="Specify depth, lane blockage, water pooling, or specific hazards..." class="w-full px-4 py-2.5 rounded-xl border border-civic-border text-sm text-civic-title placeholder:text-slate-400 focus:outline-none focus:border-civic-primary focus:ring-2 focus:ring-civic-primary/15 resize-none"></textarea>
        </div>

        <!-- Submit Button -->
        <button type="submit" class="w-full h-12 rounded-full bg-civic-primary hover:bg-civic-dark text-white font-semibold text-sm flex items-center justify-center gap-2 transition-all shadow-sm hover:shadow mt-2">
          <span class="material-symbols-outlined text-base">send</span>
          <span>Submit Road Hazard Report</span>
        </button>

        <p class="text-xs text-center text-civic-muted pt-2">
          Need to verify road statuses? <a href="verify" class="font-semibold text-civic-primary hover:underline">View live damage & heat map</a>
        </p>
      </form>
    </div>

    <!-- 3 Matching Reassurance Badges -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5 mt-6">
      <div class="p-4 rounded-2xl bg-white border border-civic-border flex items-center gap-3">
        <div class="w-9 h-9 rounded-full bg-civic-light text-civic-primary flex items-center justify-center shrink-0">
          <span class="material-symbols-outlined text-lg">schedule</span>
        </div>
        <p class="text-[11px] text-civic-muted leading-tight"><strong class="text-civic-title font-semibold block mb-0.5">&lt; 48h Turnaround</strong>Field Inspection Guarantee</p>
      </div>

      <div class="p-4 rounded-2xl bg-white border border-civic-border flex items-center gap-3">
        <div class="w-9 h-9 rounded-full bg-civic-light text-civic-primary flex items-center justify-center shrink-0">
          <span class="material-symbols-outlined text-lg">notifications_active</span>
        </div>
        <p class="text-[11px] text-civic-muted leading-tight"><strong class="text-civic-title font-semibold block mb-0.5">Real-Time SMS Alerts</strong>Track Status Progression</p>
      </div>

      <div class="p-4 rounded-2xl bg-white border border-civic-border flex items-center gap-3">
        <div class="w-9 h-9 rounded-full bg-civic-light text-civic-primary flex items-center justify-center shrink-0">
          <span class="material-symbols-outlined text-lg">verified</span>
        </div>
        <p class="text-[11px] text-civic-muted leading-tight"><strong class="text-civic-title font-semibold block mb-0.5">Public Works Unit</strong>Direct Crew Dispatch</p>
      </div>
    </div>
  </main>
</div>

@code {
    private string activeTab = "report";
}