@page "/"
@rendermode InteractiveServer

<PageTitle>KalsadaWatch - Public Infrastructure Monitoring</PageTitle>

<div class="min-h-screen font-sans bg-civic-bg text-civic-body antialiased flex flex-col scroll-smooth page-transition">
  <!-- Navigation Bar with Animated Indicator -->
  <header class="w-full sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-civic-border transition-all duration-300">
    <div class="max-w-7xl mx-auto px-6 lg:px-10 h-20 flex items-center justify-between">
      <a href="/?tab=home#top" @onclick='() => SetActiveTab("home")' class="flex items-center gap-3 group active:scale-95 transition-transform duration-200 cursor-pointer">
        <div class="w-10 h-10 rounded-xl bg-civic-light text-civic-primary flex items-center justify-center group-hover:bg-civic-primary group-hover:text-white transition-all duration-300 shadow-sm">
          <span class="material-symbols-outlined text-2xl">account_balance</span>
        </div>
        <div>
          <span class="text-xl font-bold tracking-tight text-civic-primary group-hover:text-civic-dark transition-colors">KalsadaWatch</span>
          <span class="block text-xs text-civic-muted -mt-0.5">Public Infrastructure Monitoring</span>
        </div>
      </a>

      <!-- Functional In-Page Nav Links with Animated Active Indicator -->
      <nav class="hidden md:flex items-center gap-8 text-sm font-medium">
        
        <!-- Home Tab -->
        <a href="#top" 
           @onclick='() => SetActiveTab("home")'
           class="group relative pb-2 transition-all duration-200 cursor-pointer active:scale-95 @(activeTab == "home" ? "text-civic-primary font-semibold" : "text-civic-muted hover:text-civic-primary")">
          Home
          <span class="absolute bottom-0 left-0 h-[2.5px] rounded-full bg-civic-primary transition-all duration-300 ease-out @(activeTab == "home" ? "w-full opacity-100 shadow-[0_1px_6px_rgba(37,99,235,0.4)]" : "w-0 opacity-0 group-hover:w-full group-hover:opacity-40")"></span>
        </a>

        <!-- Report Road Tab -->
        <a href="report" 
           @onclick='() => SetActiveTab("report")'
           class="group relative pb-2 transition-all duration-200 cursor-pointer active:scale-95 @(activeTab == "report" ? "text-civic-primary font-semibold" : "text-civic-muted hover:text-civic-primary")">
          Report Road
          <span class="absolute bottom-0 left-0 h-[2.5px] rounded-full bg-civic-primary transition-all duration-300 ease-out @(activeTab == "report" ? "w-full opacity-100 shadow-[0_1px_6px_rgba(37,99,235,0.4)]" : "w-0 opacity-0 group-hover:w-full group-hover:opacity-40")"></span>
        </a>

        <!-- How It Works Tab -->
        <a href="#workflow" 
           @onclick='() => SetActiveTab("workflow")'
           class="group relative pb-2 transition-all duration-200 cursor-pointer active:scale-95 @(activeTab == "workflow" ? "text-civic-primary font-semibold" : "text-civic-muted hover:text-civic-primary")">
          How It Works
          <span class="absolute bottom-0 left-0 h-[2.5px] rounded-full bg-civic-primary transition-all duration-300 ease-out @(activeTab == "workflow" ? "w-full opacity-100 shadow-[0_1px_6px_rgba(37,99,235,0.4)]" : "w-0 opacity-0 group-hover:w-full group-hover:opacity-40")"></span>
        </a>

        <!-- Road Damage Map Tab -->
        <a href="verify" 
           class="group relative pb-2 transition-all duration-200 cursor-pointer active:scale-95 @(activeTab == "map" ? "text-civic-primary font-semibold" : "text-civic-muted hover:text-civic-primary")">
          Road Damage Map
          <span class="absolute bottom-0 left-0 h-[2.5px] rounded-full bg-civic-primary transition-all duration-300 ease-out @(activeTab == "map" ? "w-full opacity-100 shadow-[0_1px_6px_rgba(37,99,235,0.4)]" : "w-0 opacity-0 group-hover:w-full group-hover:opacity-40")"></span>
        </a>

        <!-- Statistics Tab -->
        <a href="#stats" 
           @onclick='() => SetActiveTab("stats")'
           class="group relative pb-2 transition-all duration-200 cursor-pointer active:scale-95 @(activeTab == "stats" ? "text-civic-primary font-semibold" : "text-civic-muted hover:text-civic-primary")">
          Statistics
          <span class="absolute bottom-0 left-0 h-[2.5px] rounded-full bg-civic-primary transition-all duration-300 ease-out @(activeTab == "stats" ? "w-full opacity-100 shadow-[0_1px_6px_rgba(37,99,235,0.4)]" : "w-0 opacity-0 group-hover:w-full group-hover:opacity-40")"></span>
        </a>

        <!-- Help / Support Tab -->
        <a href="#emergency" 
           @onclick='() => SetActiveTab("emergency")'
           class="group relative pb-2 transition-all duration-200 cursor-pointer active:scale-95 @(activeTab == "emergency" ? "text-civic-primary font-semibold" : "text-civic-muted hover:text-civic-primary")">
          Help / Support
          <span class="absolute bottom-0 left-0 h-[2.5px] rounded-full bg-civic-primary transition-all duration-300 ease-out @(activeTab == "emergency" ? "w-full opacity-100 shadow-[0_1px_6px_rgba(37,99,235,0.4)]" : "w-0 opacity-0 group-hover:w-full group-hover:opacity-40")"></span>
        </a>

      </nav>

      <!-- Routing Buttons -->
      <div class="flex items-center gap-3">
        <a href="signin" class="text-sm font-semibold text-civic-primary px-4 py-2 hover:bg-civic-light/60 active:scale-95 rounded-full transition-all duration-200 cursor-pointer">Sign In</a>
        <a href="register" class="text-sm font-semibold text-white bg-civic-primary hover:bg-civic-dark active:scale-95 hover:shadow-md hover:-translate-y-0.5 px-5 py-2.5 rounded-full shadow-sm transition-all duration-200 cursor-pointer inline-flex items-center gap-1">Register</a>
      </div>
    </div>
  </header>

  <!-- Hero Section -->
  <section id="top" class="relative pt-16 pb-20 overflow-hidden bg-gradient-to-br from-[#D6E8FF]/60 via-[#F0F6FF] to-white scroll-mt-20">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        <div class="lg:col-span-7 pt-4">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-civic-light text-civic-primary text-xs font-semibold mb-6">
            <span class="w-2 h-2 rounded-full bg-civic-primary animate-pulse"></span> Official Citizen Pothole & Road Hazard Portal
          </div>
          <h1 class="text-4xl sm:text-5xl lg:text-[46px] font-bold text-civic-title leading-[1.2] tracking-tight mb-6">
            Report Damaged Roads, Track Real Civic Repairs in Your City.
          </h1>
          <p class="text-base sm:text-lg text-civic-muted leading-relaxed mb-8 max-w-xl">
            A transparent civic oversight platform accelerating public works response to potholes, asphalt cracks, and roadway hazards.
          </p>
          <div class="flex flex-wrap items-center gap-4 mb-10">
            <a href="report" class="inline-flex items-center gap-2 px-6 h-12 rounded-full bg-civic-primary text-white font-semibold text-sm hover:bg-civic-dark transition-colors shadow-sm">
              <span class="material-symbols-outlined text-lg">add_circle</span> Report Now
            </a>
            <a href="verify" class="inline-flex items-center gap-2 px-6 h-12 rounded-full border border-civic-primary text-civic-primary font-semibold text-sm hover:bg-civic-light/40 transition-colors">
              <span class="material-symbols-outlined text-lg">map</span> View Damage Map
            </a>
          </div>
          <div class="flex flex-wrap items-center gap-6 pt-2 text-xs font-medium text-civic-muted border-t border-civic-border">
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined text-civic-primary text-base">verified_user</span>
              <span>Integrated with Public Works</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined text-civic-primary text-base">schedule</span>
              <span>SLA Response &lt; 48 Hours</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined text-civic-primary text-base">location_on</span>
              <span>Geotag & Photo-Verified</span>
            </div>
          </div>
        </div>

        <div class="lg:col-span-5 space-y-6">
          <!-- Stat Grid (Linked by #stats) -->
          <div id="stats" class="grid grid-cols-2 gap-4 bg-white/70 backdrop-blur-sm p-6 rounded-2xl border border-civic-border scroll-mt-24">
            <div class="space-y-1">
              <div class="w-10 h-10 rounded-full bg-civic-light text-civic-primary flex items-center justify-center mb-2">
                <span class="material-symbols-outlined text-xl">assignment_turned_in</span>
              </div>
              <div class="text-3xl font-bold text-civic-title">@reportsCount.ToString("N0")+</div>
              <div class="text-xs text-civic-muted">Reports Received</div>
            </div>
            <div class="space-y-1">
              <div class="w-10 h-10 rounded-full bg-civic-light text-civic-primary flex items-center justify-center mb-2">
                <span class="material-symbols-outlined text-xl">check_circle</span>
              </div>
              <div class="text-3xl font-bold text-civic-title">@resolutionRate%</div>
              <div class="text-xs text-civic-muted">Resolution Rate</div>
            </div>
            <div class="space-y-1 pt-2 border-t border-civic-border">
              <div class="w-10 h-10 rounded-full bg-civic-light text-civic-primary flex items-center justify-center mb-2">
                <span class="material-symbols-outlined text-xl">timer</span>
              </div>
              <div class="text-3xl font-bold text-civic-title">@avgResponseHours Hours</div>
              <div class="text-xs text-civic-muted">Average Response</div>
            </div>
            <div class="space-y-1 pt-2 border-t border-civic-border">
              <div class="w-10 h-10 rounded-full bg-civic-light text-civic-primary flex items-center justify-center mb-2">
                <span class="material-symbols-outlined text-xl">travel_explore</span>
              </div>
              <div class="text-3xl font-bold text-civic-title">@districtsCovered Districts</div>
              <div class="text-xs text-civic-muted">Districts Covered</div>
            </div>
          </div>

          <!-- Urgent Assistance (Linked by #emergency) -->
          <div id="emergency" class="rounded-2xl p-6 text-white bg-[#2246CC] scroll-mt-24">
            <div class="flex items-center gap-2 mb-2">
              <span class="material-symbols-outlined text-xl text-yellow-300">emergency</span>
              <h3 class="text-lg font-bold">Need Urgent Road Assistance?</h3>
            </div>
            <p class="text-xs text-blue-100 mb-6 leading-relaxed">
              Severe road collapse or dangerous hazard risk? Contact rapid emergency road dispatch immediately.
            </p>
            <div class="flex items-center gap-3">
              <a href="tel:911" class="inline-flex items-center gap-2 px-4 py-2 border border-white/40 rounded-lg text-xs font-semibold text-white hover:bg-white/10 transition-colors">
                <span class="material-symbols-outlined text-sm">call</span> Call Hotline / Emergency
              </a>
              <a href="#map" class="text-xs font-semibold text-white hover:underline flex items-center gap-1">
                Priority Dispatch &rarr;
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Step Breakdown (Linked by #workflow) -->
  <section id="workflow" class="py-16 bg-white border-y border-civic-border scroll-mt-20">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="text-xs font-bold uppercase tracking-wider text-civic-primary">Transparent Public Service</span>
        <h2 class="text-2xl sm:text-3xl font-bold text-civic-title mt-2">Transparent Reporting Workflow</h2>
        <p class="text-sm text-civic-muted mt-2">Three streamlined accountability steps ensuring every citizen report receives verified field action.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 rounded-2xl bg-civic-bg border border-civic-border">
          <div class="w-10 h-10 rounded-full bg-civic-light text-civic-primary flex items-center justify-center mb-4">
            <span class="material-symbols-outlined text-xl">photo_camera</span>
          </div>
          <span class="text-xs font-bold text-civic-primary uppercase">Step 01</span>
          <h3 class="text-base font-bold text-civic-title mt-1 mb-2">01 – Photo & GPS Pin</h3>
          <p class="text-xs text-civic-muted leading-relaxed">Capture pothole condition on site. Precision GPS coordinates and timestamp are automatically tagged.</p>
        </div>
        <div class="p-6 rounded-2xl bg-civic-bg border border-civic-border">
          <div class="w-10 h-10 rounded-full bg-civic-light text-civic-primary flex items-center justify-center mb-4">
            <span class="material-symbols-outlined text-xl">groups</span>
          </div>
          <span class="text-xs font-bold text-civic-primary uppercase">Step 02</span>
          <h3 class="text-base font-bold text-civic-title mt-1 mb-2">02 – Field Inspection & Dispatch</h3>
          <p class="text-xs text-civic-muted leading-relaxed">Public works engineers verify damage severity, allocate asphalt materials, and dispatch rapid repair units.</p>
        </div>
        <div class="p-6 rounded-2xl bg-civic-bg border border-civic-border">
          <div class="w-10 h-10 rounded-full bg-civic-light text-civic-primary flex items-center justify-center mb-4">
            <span class="material-symbols-outlined text-xl">task_alt</span>
          </div>
          <span class="text-xs font-bold text-civic-primary uppercase">Step 03</span>
          <h3 class="text-base font-bold text-civic-title mt-1 mb-2">03 – Paving & Completed Documentation</h3>
          <p class="text-xs text-civic-muted leading-relaxed">High-grade asphalt paving executed. After-repair proof photos published and tickets closed transparently.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Live Map Section (Linked by #map) -->
  <section id="map" class="py-16 bg-civic-bg scroll-mt-20">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
        <div>
          <div class="inline-flex items-center gap-1.5 text-xs font-semibold text-civic-primary mb-1">
            <span class="w-2 h-2 rounded-full bg-civic-primary"></span> Live Citizen Feed
          </div>
          <h2 class="text-2xl font-bold text-civic-title">Real-Time Map & Road Reports</h2>
          <p class="text-xs text-civic-muted">Track live public works repair dispatches across your area.</p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
          <a href="verify" class="px-4 py-1.5 rounded-full text-xs font-semibold bg-civic-primary text-white hover:bg-civic-dark transition-colors inline-flex items-center gap-1.5 shadow-sm">
            <span class="material-symbols-outlined text-sm">open_in_new</span> Open Verification Hub & Heat Map
          </a>
        </div>
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        <div class="lg:col-span-7 bg-white p-6 rounded-2xl border border-civic-border flex flex-col justify-between">
          <div class="flex items-center justify-between mb-4">
            <div class="flex items-center gap-2 text-sm font-bold text-civic-title">
              <span class="material-symbols-outlined text-civic-primary">location_on</span> Spatial Hazard Distribution
            </div>
            <span class="text-xs text-civic-muted bg-slate-100 px-2.5 py-1 rounded-full">Updated 4m ago</span>
          </div>
          <div class="relative w-full h-64 bg-slate-100 rounded-xl overflow-hidden flex items-center justify-center border border-slate-200">
            <div class="absolute inset-0 bg-gradient-to-tr from-blue-100/60 to-slate-200/40"></div>
            <div class="relative text-center p-4">
              <span class="material-symbols-outlined text-4xl text-civic-primary mb-1">map</span>
              <p class="text-xs font-bold text-civic-title">18 Active Repair Zones Today</p>
              <p class="text-[11px] text-civic-muted">High congestion corridor: Downtown Main Ave</p>
            </div>
            <button class="absolute bottom-3 right-3 text-[11px] font-semibold bg-white text-civic-primary px-3 py-1.5 rounded-lg shadow-sm border border-slate-200 flex items-center gap-1">
              <span class="material-symbols-outlined text-sm">layers</span> Satellite Overlay Active
            </button>
          </div>
          <div class="grid grid-cols-3 gap-4 pt-6 mt-4 border-t border-civic-border text-center sm:text-left">
            <div>
              <p class="text-[11px] text-civic-muted">Verified Reports</p>
              <p class="text-lg font-bold text-civic-title">1,240 Reports</p>
            </div>
            <div>
              <p class="text-[11px] text-civic-muted">Asphalt Deployed</p>
              <p class="text-lg font-bold text-civic-title">420 Tons</p>
            </div>
            <div>
              <p class="text-[11px] text-civic-muted">Field Repair Crews</p>
              <p class="text-lg font-bold text-civic-title">14 Crews</p>
            </div>
          </div>
        </div>

        <div class="lg:col-span-5 space-y-3">
          <div class="p-4 bg-white rounded-xl border border-civic-border hover:border-civic-primary/40 transition-colors">
            <div class="flex items-center justify-between mb-2">
              <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-blue-50 text-blue-700">
                <span class="w-1.5 h-1.5 rounded-full bg-blue-600"></span> Work in Progress
              </span>
              <span class="text-xs text-civic-muted font-mono">ID: #KW-8921</span>
            </div>
            <h4 class="text-sm font-bold text-civic-title">Deep Pothole (12 inches)</h4>
            <p class="text-xs text-civic-muted mt-0.5">18 Market Street / Central Blvd</p>
            <div class="flex items-center justify-between mt-3 pt-3 border-t border-slate-100 text-[11px] text-civic-muted">
              <span>Started 2h ago</span>
              <span class="font-semibold text-civic-primary">Rapid Response Crew 02</span>
            </div>
          </div>

          <div class="p-4 bg-white rounded-xl border border-civic-border hover:border-civic-primary/40 transition-colors">
            <div class="flex items-center justify-between mb-2">
              <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-amber-50 text-amber-700">
                <span class="w-1.5 h-1.5 rounded-full bg-amber-600"></span> Under Engineering Review
              </span>
              <span class="text-xs text-civic-muted font-mono">ID: #KW-8924</span>
            </div>
            <h4 class="text-sm font-bold text-civic-title">Alligator Cracking & Road Cavity</h4>
            <p class="text-xs text-civic-muted mt-0.5">45 Northway Highway</p>
            <div class="flex items-center justify-between mt-3 pt-3 border-t border-slate-100 text-[11px] text-civic-muted">
              <span>Field survey scheduled today</span>
              <span class="font-semibold text-civic-primary">Arterial Road Division</span>
            </div>
          </div>

          <div class="p-4 bg-white rounded-xl border border-civic-border hover:border-civic-primary/40 transition-colors">
            <div class="flex items-center justify-between mb-2">
              <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-50 text-emerald-700">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span> Resolved
              </span>
              <span class="text-xs text-civic-muted font-mono">ID: #KW-8910</span>
            </div>
            <h4 class="text-sm font-bold text-civic-title">Hotmix Patching Completed</h4>
            <p class="text-xs text-civic-muted mt-0.5">South Expressway Service Road</p>
            <div class="flex items-center justify-between mt-3 pt-3 border-t border-slate-100 text-[11px] text-civic-muted">
              <span>Auditor quality approved</span>
              <span class="font-semibold text-emerald-600">100% Completed</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>

@code {
    [SupplyParameterFromQuery(Name = "tab")]
    public string? TabQuery { get; set; }

    private int reportsCount = 14820;
    private double resolutionRate = 92.4;
    private int avgResponseHours = 36;
    private int districtsCovered = 28;
    private string activeTab = "home";

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(TabQuery))
        {
            activeTab = TabQuery.ToLowerInvariant();
        }
    }

    private void SetActiveTab(string tabName)
    {
        activeTab = tabName;
    }
}