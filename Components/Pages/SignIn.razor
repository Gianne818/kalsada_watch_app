@page "/signin"
@rendermode InteractiveServer

<PageTitle>KalsadaWatch - Sign In</PageTitle>

<div class="min-h-screen font-sans bg-[#EEF4FF] text-[#1E293B] antialiased flex flex-col justify-between">
  <!-- Full Universal Navigation Bar -->
  <header class="w-full sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-[#E2EAF4]">
    <div class="max-w-7xl mx-auto px-6 lg:px-10 h-20 flex items-center justify-between">
      <a href="" class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-[#DBEAFE] text-[#2563EB] flex items-center justify-center">
          <span class="material-symbols-outlined text-2xl">account_balance</span>
        </div>
        <div>
          <span class="text-xl font-bold tracking-tight text-[#2563EB]">KalsadaWatch</span>
          <span class="block text-xs text-[#64748B] -mt-0.5">Public Infrastructure Monitoring</span>
        </div>
      </a>

      <!-- In-Page Nav Links -->
      <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-[#64748B]">
        <a href="" class="hover:text-[#2563EB] transition-colors">Home</a>
        <a href="#report" class="hover:text-[#2563EB] transition-colors">Report Road</a>
        <a href="#map" class="hover:text-[#2563EB] transition-colors">Road Damage Map</a>
        <a href="#stats" class="hover:text-[#2563EB] transition-colors">Statistics</a>
        <a href="#help" class="hover:text-[#2563EB] transition-colors">Help / Support</a>
      </nav>

      <!-- Right Nav Controls -->
      <div class="flex items-center gap-4">
        

        <!-- Active Underline for Sign In -->
        <a href="signin" class="relative text-sm font-semibold text-[#2563EB] pb-1">
          Sign In
          <span class="absolute bottom-0 left-0 w-full h-[2.5px] rounded-full bg-[#2563EB]"></span>
        </a>

        <a href="register" class="text-sm font-semibold text-white bg-[#2563EB] hover:bg-[#1E40AF] px-6 py-2.5 rounded-full shadow-sm transition-all duration-200 hover:shadow">
          Register
        </a>
      </div>
    </div>
  </header>

  <!-- Sign In Card Center -->
  <main class="flex-1 flex flex-col items-center justify-center py-12 px-6">
    <div class="w-full max-w-[480px] bg-white rounded-3xl border border-[#E2EAF4] p-8 sm:p-10 shadow-[0_10px_30px_-10px_rgba(37,99,235,0.08)]">
      
      <!-- Top Icon -->
      <div class="w-12 h-12 rounded-full bg-[#DBEAFE] text-[#2563EB] flex items-center justify-center mx-auto mb-4">
        <span class="material-symbols-outlined text-2xl">verified_user</span>
      </div>

      <div class="text-center mb-7">
        <h1 class="text-2xl sm:text-[26px] font-bold text-[#0F172A]">Sign In to KalsadaWatch</h1>
        <p class="text-xs text-[#64748B] mt-2 leading-relaxed max-w-sm mx-auto">
          Access your citizen account to track repair progress and view reported road hazards
        </p>
      </div>

      <form class="space-y-4" @onsubmit="HandleSignIn">
        <div>
          <label class="block text-xs font-semibold text-[#0F172A] mb-1.5">National Citizen ID (NIK) or Email Address</label>
          <div class="relative">
            <span class="material-symbols-outlined absolute left-3.5 top-3 text-[#94A3B8] text-lg">badge</span>
            <input type="text" @bind="identifier" placeholder="Enter 16-digit ID or name@email.com" class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-[#E2EAF4] text-sm text-[#0F172A] placeholder:text-[#94A3B8] focus:outline-none focus:border-[#2563EB] focus:ring-2 focus:ring-[#2563EB]/15 transition-all" required />
          </div>
          <p class="text-[11px] text-[#94A3B8] mt-1.5">Verified citizens can sign in using their official 16-digit ID.</p>
        </div>

        <div>
          <div class="flex items-center justify-between mb-1.5">
            <label class="text-xs font-semibold text-[#0F172A]">Password</label>
            <a href="#" class="text-[11px] font-semibold text-[#2563EB] hover:underline">Forgot password?</a>
          </div>
          <div class="relative">
            <span class="material-symbols-outlined absolute left-3.5 top-3 text-[#94A3B8] text-lg">lock</span>
            <input type="@passwordInputType" @bind="password" placeholder="Enter your password" class="w-full pl-10 pr-10 py-2.5 rounded-xl border border-[#E2EAF4] text-sm text-[#0F172A] placeholder:text-[#94A3B8] focus:outline-none focus:border-[#2563EB] focus:ring-2 focus:ring-[#2563EB]/15 transition-all" required />
            <button type="button" @onclick="TogglePasswordVisibility" class="material-symbols-outlined absolute right-3.5 top-3 text-[#94A3B8] hover:text-[#0F172A] text-lg transition-colors">
              @(showPassword ? "visibility_off" : "visibility")
            </button>
          </div>
        </div>

        <div class="flex items-center gap-2 pt-0.5">
          <input type="checkbox" id="remember" @bind="rememberDevice" class="w-4 h-4 rounded border-[#CBD5E1] text-[#2563EB] focus:ring-[#2563EB]" />
          <label for="remember" class="text-xs text-[#64748B] cursor-pointer">Remember this device</label>
        </div>

        <button type="submit" class="w-full h-11 rounded-full bg-[#2563EB] hover:bg-[#1E40AF] text-white font-semibold text-sm flex items-center justify-center gap-2 transition-all shadow-sm hover:shadow mt-3">
          <span>Sign In Now</span>
          <span class="material-symbols-outlined text-sm">arrow_forward</span>
        </button>

        <div class="relative my-5 text-center">
          <div class="absolute inset-0 flex items-center"><div class="w-full border-t border-[#E2EAF4]"></div></div>
          <span class="relative bg-white px-3 text-[11px] text-[#94A3B8]">or sign in with verified digital credentials</span>
        </div>

        <button type="button" class="w-full h-11 rounded-full border border-[#E2EAF4] hover:bg-slate-50 text-[#0F172A] font-semibold text-xs flex items-center justify-center gap-2 transition-colors">
          <span class="material-symbols-outlined text-[#2563EB] text-base">fingerprint</span> Digital Citizen ID (IKD / Civic Identity)
        </button>
      </form>

      <p class="text-xs text-center text-[#64748B] mt-6">
        Don't have an account yet? <a href="register" class="font-semibold text-[#2563EB] hover:underline">Register here</a>
      </p>
    </div>

    <!-- Security Subtext Note -->
    <div class="flex items-center justify-center gap-2 text-[11px] text-[#64748B] mt-5 max-w-md text-center leading-relaxed">
      <span class="material-symbols-outlined text-sm text-[#94A3B8] shrink-0">lock</span>
      <span>Official 256-bit SSL encrypted government portal complying with National Cyber Security Standards.</span>
    </div>
  </main>


  
</div>

@code {
    private string identifier = "";
    private string password = "";
    private bool rememberDevice = false;
    private bool showPassword = false;

    private string passwordInputType => showPassword ? "text" : "password";

    private void TogglePasswordVisibility()
    {
        showPassword = !showPassword;
    }

    private void HandleSignIn()
    {
        // Add authentication logic here
    }
}